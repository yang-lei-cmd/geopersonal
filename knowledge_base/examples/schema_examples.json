  "schemas": {
    "article_standard": {
      "name": "标准文章Schema",
      "use_case": "博客文章、新闻稿、专题报道",
      "code": {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "文章标题，包含核心关键词",
        "description": "2-3句话摘要，第一句必须直接回答问题或给出结论",
        "image": [
          "https://example.com/featured-image-1200x630.jpg"
        ],
        "author": {
          "@type": "Person",
          "name": "作者姓名",
          "jobTitle": "职位头衔",
          "url": "https://example.com/author-page",
          "sameAs": [
            "https://twitter.com/author_handle",
            "https://linkedin.com/in/author_profile"
          ]
        },
        "publisher": {
          "@type": "Organization",
          "name": "公司/品牌名称",
          "logo": {
            "@type": "ImageObject",
            "url": "https://example.com/logo.png",
            "width": 600,
            "height": 60
          }
        },
        "datePublished": "2024-11-18T08:00:00+08:00",
        "dateModified": "2024-11-18T14:30:00+08:00",
        "wordCount": 2500,
        "inLanguage": "zh-CN",
        "articleSection": "技术应用",
        "keywords": ["关键词1", "关键词2", "关键词3"],
        "mentions": {
          "@type": "Thing",
          "name": "相关实体/人物"
        }
      }
    },
    
    "faq_page": {
      "name": "FAQ页面Schema",
      "use_case": "帮助中心、常见问题页面、产品说明页",
      "tips": [
        "每个问题答案控制在80-150字",
        "首句必须直接回答，不绕弯子",
        "最多放10-15个问题，避免信息过载"
      ],
      "code": {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "问题一：简洁明确的提问",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "直接给出明确答案。首句必须是答案本身，不要说'根据我们的经验...'或直接重复问题。最好控制在3-5句话内。"
            }
          },
          {
            "@type": "Question",
            "name": "问题二：用户常问的第二个问题",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "这里是第二个问题的标准答案格式..."
            }
          }
        ]
      }
    },
    
    "howto_guide": {
      "name": "教程步骤Schema",
      "use_case": "操作指南、安装教程、流程说明",
      "tips": [
        "步骤编号从1开始连续",
        "每步不超过200字",
        "可附带图片URL增强可理解性"
      ],
      "code": {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": "教程标题（动词开头，如'如何配置XX'）",
        "description": "一句话概括本教程能帮助读者完成什么",
        "totalTime": "PT15M",
        "supply": [
          {"@type": "HowToSupply", "name": "所需物品/工具1"},
          {"@type": "HowToSupply", "name": "所需物品/工具2"}
        ],
        "tool": [
          {"@type": "HowToTool", "name": "使用的工具/软件"}
        ],
        "step": [
          {
            "@type": "HowToDirection",
            "name": "步骤标题",
            "text": "详细步骤描述...",
            "url": "https://example.com/image-step1.jpg",
            "doesNotApply": {
              "@type": "HowToPart",
              " appliesTo": ["US", "CA"]
            }
          }
        ]
      }
    },
    

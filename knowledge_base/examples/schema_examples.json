  "validation_tools": {
    "google_rich_results_test": {
      "url": "https://search.google.com/test/rich-results",
      "use": "验证Rich Results兼容性"
    },
    "schema_markup_wizard": {
      "url": "https://www.schema.dev/",
      "use": "可视化Schema编辑器"
    },
    "jsonlint": {
      "url": "https://jsonlint.com/",
      "use": "校验JSON格式"
    }
  },
  
  "best_practices_checklist": {
    "syntax_rules": [
      "使用application/ld+json类型",
      "确保JSON语法正确（逗号、引号）",
      "所有required字段都已填充",
      "@context必须存在且值为'https://schema.org'"
    ],
    "content_guidelines": [
      "值必须是具体、可验证的信息",
      "避免模糊表述如'很多好评'",
      "日期统一使用ISO 8601格式",
      "URL使用绝对路径而非相对路径"
    ],
    "placement_tips": [
      "放在<head>标签内确保爬虫第一时间读取",
      "同一页面只使用一种主要Schema类型",
      "多个Schema时用数组包裹或使用嵌套结构",
      "移动端和桌面端保持一致的Schema标记"
    ]
  }
}
